PORT=3000
PASSWORD=admin123
PING_INTERVAL_MS=60000
HTTPS_ENABLED=false
HTTPS_PORT=3443
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# Alerting
# 32-byte hex key for encrypting sensitive config (bot tokens, SMTP passwords)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALERT_ENCRYPTION_KEY=

# Discovery
DISCOVERY_MAX_CONCURRENCY=20

# Plugins
PLUGIN_MAX_UPLOAD_MB=5
